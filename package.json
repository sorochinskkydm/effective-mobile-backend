{
    "name": "effective-mobile",
    "version": "1.0.0",
    "description": "",
    "main": "src/main.ts",
    "scripts": {
        "build": "tsc",
        "start:dev": "nodemon",
        "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
        "migration:generate": "npm run typeorm -- migration:generate -d ./src/modules/infra/postgres/typeorm.config.ts ./src/modules/infra/postgres/migrations/$npm_config_name",
        "migration:run": "npm run typeorm -- migration:run -d ./src/modules/infra/postgres/typeorm.config.ts ",
        "migration:revert": "npm run typeorm -- migration:revert -d ./src/modules/infra/postgres/typeorm.config.ts "
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sorochinskkydm/effective-mobile-backend.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/sorochinskkydm/effective-mobile-backend/issues"
    },
    "homepage": "https://github.com/sorochinskkydm/effective-mobile-backend#readme",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "class-validator": "^0.15.1",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "swagger-ui-express": "^5.0.1",
        "tsconfig-paths": "^4.2.0",
        "typeorm": "^0.3.28"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.5.0",
        "@types/pg": "^8.18.0",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
